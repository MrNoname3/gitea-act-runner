{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Conservative automerge: patch/pin/digest across managers, after a 3-day soak",
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Also automerge GitHub Actions minor updates (same 3-day soak)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "The job image's base images update together on the first of the month: each update rebuilds the image",
      "matchFileNames": [
        "job-image.Containerfile"
      ],
      "groupName": "job image",
      "schedule": [
        "* * 1 * *"
      ]
    },
    {
      "description": "The job image's node stays on the major line GitHub runs JavaScript actions with (their runs.using); raise it when GitHub moves on",
      "matchFileNames": [
        "job-image.Containerfile"
      ],
      "matchDepNames": [
        "docker.io/library/node"
      ],
      "allowedVersions": "<25"
    }
  ]
}
